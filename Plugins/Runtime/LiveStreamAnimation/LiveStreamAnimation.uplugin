{
  "FileVersion": 3,
  "Version": 1,
  "VersionName": "1.0",
  "FriendlyName": "Live Stream Animation Plugin",
  "Description": "Used to live animation data from a single client to multiple other clients",
  "Category": "Animation",
  "CreatedBy": "Epic Games, Inc.",
  "CanContainContent": false,
  "EnabledByDefault": false,
  "Modules": [
    {
      "Name": "LiveStreamAnimation",
      "Type": "Runtime",
      "LoadingPhase": "Default"
    },
    {
      "Name": "LSALiveLink",
      "Type": "Runtime",
      "LoadingPhase": "Default"
    }
  ],
  "Plugins": [
    {
      "Name": "ForwardingChannels",
      "Enabled": true
    },
    {
      "Name": "LiveLink",
      "Enabled": true
    }
  ]
}
